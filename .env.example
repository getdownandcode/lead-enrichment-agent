# Required for LLM enrichment. Create a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# This can be changed via GEMINI_MODEL when Google releases a newer identifier.
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: enables Tavily-powered public-web leadership lookup.
TAVILY_API_KEY=

MAX_PAGES=6
REQUEST_TIMEOUT_SECONDS=20
MAX_PAGE_TEXT_CHARS=7000
